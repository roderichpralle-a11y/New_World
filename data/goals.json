{
  "_doc": "Einführung (tutorial) und Ziele (milestones, danach endlos erzeugt). close_after: nach dem Schritt alle Fenster schließen. check.type: selected_settler, action (kind next = Knopf Weiter, place = Hammer eines Gebäudes, job_list = Berufsliste geöffnet; or_job: auch erfüllt, wenn es den Beruf schon gibt), no_panel (kein Fenster offen), tech_started (what), building (n, any = auch Baustellen), housing, pop, techs (all: true = der ganze Baum), tier, tech, variety, islands_found, islands_settled, kills, births, speed, stock, job (what, n: so viele Siedler mit diesem Beruf). point: build, research, settlers, speed, settler, info.",
  "tutorial": [
    {"id": "t_top_holz", "text": "Das ist dein Holz.", "hint": "Du brauchst es zum Bauen, Forschen und Heizen.", "check": {"type": "action", "kind": "next"}, "point": "top_holz"},
    {"id": "t_stock_open", "text": "Tippe auf die Statuszeile, um das Lager zu öffnen.", "check": {"type": "action", "kind": "panel", "what": "lager"}, "point": "top_bar"},
